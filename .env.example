# 部署配置模板 —— **复制成 .env 再改** ✓（`.env` 是 gitignore 的 ✓，**别把它提交** ✗）
#
# 上线前先跑一遍自检 ✓：
#     python scripts/check_deploy.py        # 秒级 ✓：环境/目录/依赖/凭据全查一遍
#     python scripts/check_deploy.py --deep # 加抽图 + OCR 冒烟（分钟级 ✓）

# ── 模型凭据 ──────────────────────────────────────────────────────────
# MiniMax 后端（单把）
MINIMAX_API_KEY=sk-cp-你的key
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_MODEL=MiniMax-M3

# 跨供应商凭据池（推荐 ✓）：一把额度满了自动切下一家 ✓，**不用改代码** ✓。
# 格式：供应商|key|baseUrl|模型   —— **多条用逗号分隔** ✓
# 分隔符用 `|` 而不是 `:` —— baseUrl 自己带 `:`（https://…）✗，用 `:` 切会切坏 ✓。
# 供应商名见 server/_core/minimaxPool.ts 的 PROVIDER_DEFAULTS ✓（minimax / openai / … ✓）。
MODEL_KEY_POOL=minimax|sk-cp-你的key|https://api.minimax.cn|MiniMax-M3

# ── 站点级认证（**公网暴露前必配** ✓）────────────────────────────────
# 格式：<用户名>:<sha256("用户名:口令") 的十六进制>
# 不配 ⇒ **完全不拦** ✓（本地开发照旧 ✓）；配了 ⇒ 除白名单外一律 401 ✓（浏览器会弹登录框 ✓）。
# 生成：python -c "import hashlib;print(hashlib.sha256(b'gea:你的口令').hexdigest())"
SITE_BASIC_AUTH=
# 白名单（默认只有健康检查 ✓ —— 容器 HEALTHCHECK 靠它 ✓）
SITE_BASIC_AUTH_OPEN=/api/health

# ── 会话与数据库 ──────────────────────────────────────────────────────
# 会话签名（部署时生成随机串 ✓ —— **别用示例值** ✗）
JWT_SECRET=change-me-to-32-char-random-string

# 数据库（生产环境必填 ✓ —— 不填走 in-memory ⇒ **重启丢数据** ✗）
DATABASE_URL=mysql://user:pass@host:3306/dbname

# ── 渲染与字体 ────────────────────────────────────────────────────────
# PDF 渲染用的中文字体（容器里是 fonts-noto-cjk ✓ —— **必须挂进去** ✓，
# 否则渲染出豆腐块 ✗）。容器内路径：
REPORT_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJKsc-Light.otf
# Windows 服务器上改成微软雅黑 ✓：
#   REPORT_FONT_PATH=C:\Windows\Fonts\msyh.ttc

# 渲染用的**浏览器** ✓ —— 默认找系统 Chrome ✓；
# **公司服务器上只有 Edge、没有 Chrome** ✓（实测 2026-11-19）⇒ 必配这一行 ✓，
# 不配 ⇒ 渲染直接失败 ✗ ⇒ **出不了交付件** ✗。
PLAYWRIGHT_CHANNEL=msedge

# 服务端口（**与 Dockerfile 的 EXPOSE 一致** ✓ —— 以前是 8080 vs 3000 ⇒ 部署时对不上 ✗）
PORT=3000
NODE_ENV=production

# ── 可选：外部服务（不填就降级 ✓）────────────────────────────────────
# Manus OAuth（不填走 demo 模式免登录 ✓）
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Manus Forge 对象存储（不填降级为 data: URL ✓）
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# RAG-Anything 文档解析（不填纯前端 pdfjs ✓）
RAG_ANYTHING_BASE_URL=
RAG_ANYTHING_API_KEY=

# ── 容器部署时的数据目录（建议挂成卷 ✓ —— 上传的法规原文与报告都在这儿 ⚠）──
# 上传的源 PDF：/app/uploaded-docs
# 生成的报告：  /app/reports
# 例：docker run -v /srv/copilot/uploads:/app/uploaded-docs -v /srv/copilot/reports:/app/reports …
