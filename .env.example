# 必填：MiniMax 后端
MINIMAX_API_KEY=sk-cp-你的key
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_MODEL=MiniMax-M3

# 必填：会话签名（部署时生成随机串）
JWT_SECRET=change-me-to-32-char-random-string

# 推荐：数据库（生产环境必填，dev 可不填走 in-memory）
DATABASE_URL=mysql://user:pass@host:3306/dbname

# 可选：Manus OAuth（不填走 demo 模式免登录）
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# 可选：Manus Forge 对象存储（不填降级为 data: URL）
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# 可选：RAG-Anything 文档解析（不填纯前端 pdfjs）
RAG_ANYTHING_BASE_URL=
RAG_ANYTHING_API_KEY=

# 可选：PDF 中文字体路径（生产容器需挂载字体）
REPORT_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJKsc-Light.otf

# 服务端口（Render 自动注入 PORT）
PORT=3000
NODE_ENV=production